# Common options
CONFIG_QTI_QRTR=y
CONFIG_QTI_RMNET=y
CONFIG_QTI_QMI_RMNET=y
CONFIG_QTI_QMI_DFC=y
CONFIG_QTI_QMI_POWER_COLLAPSE=y
CONFIG_QTI_USB_BRIDGE=y
CONFIG_QTI_QDSS_BRIDGE=y

# Ethernet option
CONFIG_QTI_QRTR_ETHERNET=y

# PCIe options
CONFIG_QTI_MHI_BUS=y
CONFIG_QTI_MHI_DEBUG=y
CONFIG_QTI_MHI_PCI_GENERIC=y
CONFIG_QTI_MHI_QCOM=y
CONFIG_QTI_MHI_UCI=y
CONFIG_QTI_MHI_NETDEV=y
CONFIG_QTI_QRTR_MHI=y
CONFIG_QTI_RMNET_CTL=y

# USB options
CONFIG_QTI_QRTR_USB=y
CONFIG_QTI_USB_RMNET=y
CONFIG_QTI_USB_KS_BRIDGE=y
CONFIG_QTI_USB_MDM_DATA_BRIDGE=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_RNDIS_HOST=y

# QMI options
CONFIG_QTI_QMI_HELPERS=y

# Diag options
CONFIG_QTI_DIAG_CHAR=y
CONFIG_QTI_USB_F_DIAG=y
CONFIG_QTI_USB_DIAG_BRIDGE=y

# non-QTI config options
CONFIG_USB_CONFIGFS=y
CONFIG_USB_GADGET=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_BLK_DEV_NBD=y
CONFIG_VLAN_8021Q=y

# Side Band config options
CONFIG_SDX_EXT_IPC=y
CONFIG_QTI_NOTIFY_SIDEBAND=y

#enable devnmem with restrictions
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=n
CONFIG_IO_STRICT_DEVMEM=n

#enable GPIO
CONFIG_GPIO_CDEV=y
