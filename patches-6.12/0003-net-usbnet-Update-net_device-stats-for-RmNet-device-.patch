From 1826022fd3259b1980cc3972b1a64a5793a16b61 Mon Sep 17 00:00:00 2001
From: venper <venper@qti.qualcomm.com>
Date: Wed, 29 Oct 2025 12:46:26 +0530
Subject: [PATCH] net usbnet Update net_device stats for RmNet device-

eap-qti-kernel 6.12 Driver Patch Updates:
A patch has been introduced in the usbnet module to support net device status reporting.

Signed-off-by: venper <venper@qti.qualcomm.com>
---
 drivers/net/usb/usbnet.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/drivers/net/usb/usbnet.c b/drivers/net/usb/usbnet.c
index 44179f4e807f..d273c1bf9a19 100644
--- a/drivers/net/usb/usbnet.c
+++ b/drivers/net/usb/usbnet.c
@@ -333,6 +333,10 @@ void usbnet_skb_return (struct usbnet *dev, struct sk_buff *skb)
 	flags = u64_stats_update_begin_irqsave(&stats64->syncp);
 	u64_stats_inc(&stats64->rx_packets);
 	u64_stats_add(&stats64->rx_bytes, skb->len);
+	if (dev->net->netdev_ops->ndo_get_stats) {
+		dev->net->stats.rx_packets++;
+		dev->net->stats.rx_bytes += skb->len;
+	}
 	u64_stats_update_end_irqrestore(&stats64->syncp, flags);
 
 	netif_dbg(dev, rx_status, dev->net, "< rx, len %zu, type 0x%x\n",
-- 
2.17.1

