From 5d134e217042337483cb5bf65d4a12a9bc903e99 Mon Sep 17 00:00:00 2001
From: Venkatesh Perumal <venper@qti.qualcomm.com>
Date: Mon, 24 Aug 2026 16:48:35 +0530
Subject: [PATCH] LF-16863 PCI: imx6: Add runtime PM support for i.MX95 RC

Add runtime PM support for i.MX95 PCIr RC, and verified on one
RealTek8168E network card.

We added this patch to our EAP bundle.

Signed-off-by: Venkatesh Perumal <venper@qti.qualcomm.com>
---
 drivers/pci/controller/dwc/pci-imx6.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/drivers/pci/controller/dwc/pci-imx6.c b/drivers/pci/controller/dwc/pci-imx6.c
index c8c57febde0c..5dae3d831a35 100644
--- a/drivers/pci/controller/dwc/pci-imx6.c
+++ b/drivers/pci/controller/dwc/pci-imx6.c
@@ -41,6 +41,7 @@
 #define IMX8MQ_GPR_PCIE_CLK_REQ_OVERRIDE_EN	BIT(10)
 #define IMX8MQ_GPR_PCIE_CLK_REQ_OVERRIDE	BIT(11)
 #define IMX8MQ_GPR_PCIE_VREG_BYPASS		BIT(12)
+#define IMX_PCIE_FLAG_PM_RUNTIME		BIT(13)
 #define IMX8MQ_GPR12_PCIE2_CTRL_DEVICE_TYPE	GENMASK(11, 8)
 
 #define IMX95_PCIE_PHY_GEN_CTRL			0x0
@@ -2012,6 +2013,16 @@ static int imx_pcie_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
+	if (imx_pcie->drvdata->flags & IMX_PCIE_FLAG_PM_RUNTIME) {
+		ret = pm_runtime_set_active(dev);
+		if (ret < 0)
+			dev_err_probe(dev, ret, "failed to activate runtime PM\n");
+		pm_runtime_no_callbacks(dev);
+		ret = devm_pm_runtime_enable(dev);
+		if (ret < 0)
+			dev_err_probe(dev, ret, "failed to enable runtime PM\n");
+	}
+
 	if (imx_pcie->drvdata->mode == DW_PCIE_EP_TYPE) {
 		ret = imx_add_pcie_ep(imx_pcie, pdev);
 		if (ret < 0)
@@ -2088,6 +2099,11 @@ static void imx_pcie_shutdown(struct platform_device *pdev)
 		imx_pcie->host_wake_irq = -1;
 	}
 
+	if (imx_pcie->drvdata->flags & IMX_PCIE_FLAG_PM_RUNTIME) {
+		 pr_err("NXP-iMX95-RC: shutdown Tag4\n");
+		pm_runtime_put_sync(&pdev->dev);
+	}
+
 	/* bring down link, so bootloader gets clean state in case of reboot */
 	imx_pcie_assert_core_reset(imx_pcie);
 }
@@ -2201,6 +2217,7 @@ static const struct imx_pcie_drvdata drvdata[] = {
 	[IMX95] = {
 		.variant = IMX95,
 		.flags = IMX_PCIE_FLAG_HAS_SERDES |
+			 IMX_PCIE_FLAG_PM_RUNTIME |
 			 IMX_PCIE_FLAG_SUPPORTS_SUSPEND |
 			 IMX_PCIE_FLAG_LINK_NOTIFY |
 			 IMX_PCIE_FLAG_MONITOR_DEV,
-- 
