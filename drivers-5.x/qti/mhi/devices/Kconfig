menu "MHI device support"

# QTI_RMNET dependency on QTI_MHI_NETDEV is being removed
# to enumerate mhi_swip0 channels for data throughput when
# used PCIe as an interconnect.

# This dependency was added long back to resolve the compilation
# issues for qemuarm64. Gerrit: https://review-android.quicinc.com/#/c/2371495/
# But now we have tested the compilation on EAP and FSL with
# IMX6, qemuarm64, qemuarm-cv2x, qemux86-cv2x by removing the
# dependency and the compilation is successful everytime and the
# drivers are also getting compiled properly.

config QTI_MHI_NETDEV
       tristate "MHI NETDEV"
       depends on QTI_MHI_BUS
       help
	  MHI based net device driver for transferring IP traffic
	  between host and modem. By enabling this driver, clients
	  can transfer data using standard network interface.

config QTI_MHI_UCI
       tristate "MHI UCI"
       depends on QTI_MHI_BUS
       help
	  MHI based uci driver is for transferring data between host and
	  modem using standard file operations from user space. Open, read,
	  write, ioctl, and close operations are supported by this driver.

endmenu
