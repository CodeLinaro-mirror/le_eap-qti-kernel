From 4a2434f6cc524a5294f06aeb50fd903ce6f4ea96 Mon Sep 17 00:00:00 2001
From: Sanjay Dwivedi <sanjaykd@codeaurora.org>
Date: Fri, 3 Jul 2020 22:09:43 +0530
Subject: [PATCH] mhi_bus: core: Add support for MHI host interface

MHI Host Interface is a communication protocol to be used by the host
to control and communcate with modem over a high speed peripheral bus.
This module will allow host to communicate with external devices that
support MHI protocol.

Signed-off-by: Sanjay Dwivedi <sanjaykd@codeaurora.org>
---
 include/linux/mod_devicetable.h | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/include/linux/mod_devicetable.h b/include/linux/mod_devicetable.h
index 5714fd3..3bf5645 100644
--- a/include/linux/mod_devicetable.h
+++ b/include/linux/mod_devicetable.h
@@ -755,6 +755,19 @@ struct fsl_mc_device_id {
 	const char obj_type[16];
 };
 
+#define MHI_NAME_SIZE 32
+
+/**
+ * struct mhi_device_id - MHI device identification
+ * @chan: MHI channel name
+ * @driver_data: driver data;
+ */
+
+struct mhi_device_id {
+       const char chan[MHI_NAME_SIZE];
+       kernel_ulong_t driver_data;
+};
+
 /**
  * struct tb_service_id - Thunderbolt service identifiers
  * @match_flags: Flags used to match the structure
