diff --git a/drivers/qti/mhi/core/mhi_pm.c b/drivers/qti/mhi/core/mhi_pm.c
index c476a20..d2c8ee3 100644
--- a/drivers/qti/mhi/core/mhi_pm.c
+++ b/drivers/qti/mhi/core/mhi_pm.c
@@ -772,6 +772,9 @@ void mhi_pm_st_worker(struct work_struct *work)
 		case MHI_ST_TRANSITION_AMSS:
 			mhi_pm_amss_transition(mhi_cntrl);
 			break;
+		case MHI_ST_TRANSITION_READY:
+			mhi_ready_state_transition(mhi_cntrl);
+			break;
 		default:
 			break;
 		}
diff --git a/drivers/qti/mhi/devices/mhi_netdev.c b/drivers/qti/mhi/devices/mhi_netdev.c
