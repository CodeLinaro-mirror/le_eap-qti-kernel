 	for (dir = 0; dir < 2; dir++) {
 		struct uci_chan *uci_chan = (dir) ?
diff --git a/drivers/qti/qrtr/Kconfig b/drivers/qti/qrtr/Kconfig
index 61d66dd..f4b232c 100644
--- a/drivers/qti/qrtr/Kconfig
+++ b/drivers/qti/qrtr/Kconfig
@@ -1,9 +1,8 @@
 # Qualcomm IPC Router configuration
 #
 
-config QRTR
+config QRTR_QTI
 	tristate "Qualcomm IPC Router support"
-	depends on ARCH_QCOM || COMPILE_TEST
 	---help---
 	  Say Y if you intend to use Qualcomm IPC router protocol.  The
 	  protocol is used to communicate with services provided by other
@@ -12,20 +11,20 @@ config QRTR
 	  In order to do service lookups, a userspace daemon is required to
 	  maintain a service listing.
 
-if QRTR
+if QRTR_QTI
 
-config QRTR_SMD
+config QRTR_QTI_SMD
 	tristate "SMD IPC Router channels"
 	depends on RPMSG || (COMPILE_TEST && RPMSG=n)
 	---help---
 	  Say Y here to support SMD based ipcrouter channels.  SMD is the
 	  most common transport for IPC Router.
 
-config QRTR_MHI
+config QRTR_QTI_MHI
 	tristate "MHI IPC Router channels"
 	depends on MHI_BUS || (COMPILE_TEST && MHI_BUS=n)
 	---help---
 	  Say Y here to support MHI based ipcrouter channels.  MHI is the
 	  transport used for external modem connections for IPC Router.
 
-endif # QRTR
+endif # QRTR_QTI
diff --git a/drivers/qti/qrtr/Makefile b/drivers/qti/qrtr/Makefile
index c31cf13..798658e 100644
--- a/drivers/qti/qrtr/Makefile
+++ b/drivers/qti/qrtr/Makefile
@@ -1,7 +1,7 @@
-obj-$(CONFIG_QRTR) := qrtr.o
+obj-$(CONFIG_QRTR_QTI) := qrtr.o
 
-obj-$(CONFIG_QRTR_SMD) += qrtr-smd.o
+obj-$(CONFIG_QRTR_QTI_SMD) += qrtr-smd.o
 qrtr-smd-y	:= smd.o
 
-obj-$(CONFIG_QRTR_MHI) += qrtr-mhi.o
+obj-$(CONFIG_QRTR_QTI_MHI) += qrtr-mhi.o
 qrtr-mhi-y	:= mhi.o
diff --git a/drivers/qti/qrtr/qrtr.c b/drivers/qti/qrtr/qrtr.c
index a66b217..f761b08 100644
--- a/drivers/qti/qrtr/qrtr.c
+++ b/drivers/qti/qrtr/qrtr.c
@@ -192,7 +192,7 @@ static int qrtr_node_enqueue(struct qrtr_node *node, struct sk_buff *skb,
 	size_t len = skb->len;
 	int rc = -ENODEV;
 
-	hdr = skb_push(skb, sizeof(*hdr));
+	hdr = (struct qrtr_hdr_v1 *)skb_push(skb, sizeof(*hdr));
 	hdr->version = cpu_to_le32(QRTR_PROTO_VER_1);
 	hdr->type = cpu_to_le32(type);
 	hdr->src_node_id = cpu_to_le32(from->sq_node);
@@ -306,9 +306,9 @@ int qrtr_endpoint_post(struct qrtr_endpoint *ep, const void *data, size_t len)
 		cb->dst_node = le16_to_cpu(v2->dst_node_id);
 		cb->dst_port = le16_to_cpu(v2->dst_port_id);
 
-		if (cb->src_port == (u16)QRTR_PORT_CTRL)
+		if (cb->src_port == (u16)QRTR_PORT_CTRL || cb->src_port == 0x0000FFFF)
 			cb->src_port = QRTR_PORT_CTRL;
-		if (cb->dst_port == (u16)QRTR_PORT_CTRL)
+		if (cb->dst_port == (u16)QRTR_PORT_CTRL || cb->dst_port == 0x0000FFFF)
 			cb->dst_port = QRTR_PORT_CTRL;
 
 		size = le32_to_cpu(v2->size);
@@ -357,6 +357,7 @@ static struct sk_buff *qrtr_alloc_ctrl_packet(struct qrtr_ctrl_pkt **pkt)
 		return NULL;
 
 	skb_reserve(skb, QRTR_HDR_MAX_SIZE);
+
 	*pkt = skb_put_zero(skb, pkt_len);
 
 	return skb;
@@ -1092,8 +1093,7 @@ static const struct nla_policy qrtr_policy[IFA_MAX + 1] = {
 	[IFA_LOCAL] = { .type = NLA_U32 },
 };
 
-static int qrtr_addr_doit(struct sk_buff *skb, struct nlmsghdr *nlh,
-			  struct netlink_ext_ack *extack)
+static int qrtr_addr_doit(struct sk_buff *skb, struct nlmsghdr *nlh)
 {
 	struct nlattr *tb[IFA_MAX + 1];
 	struct ifaddrmsg *ifm;
@@ -1105,7 +1105,7 @@ static int qrtr_addr_doit(struct sk_buff *skb, struct nlmsghdr *nlh,
 
 	ASSERT_RTNL();
 
-	rc = nlmsg_parse(nlh, sizeof(*ifm), tb, IFA_MAX, qrtr_policy, extack);
+	rc = nlmsg_parse(nlh, sizeof(*ifm), tb, IFA_MAX, qrtr_policy);
 	if (rc < 0)
 		return rc;
 
diff --git a/drivers/qti/qrtr/qrtr.h b/drivers/qti/qrtr/qrtr.h
index b81e695..ac007b0 100644
--- a/drivers/qti/qrtr/qrtr.h
+++ b/drivers/qti/qrtr/qrtr.h
@@ -29,4 +29,23 @@ void qrtr_endpoint_unregister(struct qrtr_endpoint *ep);
 
 int qrtr_endpoint_post(struct qrtr_endpoint *ep, const void *data, size_t len);
 
+static inline void *skb_put_zero(struct sk_buff *skb, unsigned int len)
+{
+	void *tmp = skb_put(skb, len);
+
+	memset(tmp, 0, len);
+
+	return tmp;
+}
+
+static inline void *skb_put_data(struct sk_buff *skb, const void *data,
+				 unsigned int len)
+{
+	void *tmp = skb_put(skb, len);
+
+	memcpy(tmp, data, len);
+
+	return tmp;
+}
+
 #endif
diff --git a/include/linux/mhi.h b/include/linux/mhi.h
index 71eaa9f..a703fb0 100644
--- a/include/linux/mhi.h
+++ b/include/linux/mhi.h
@@ -532,8 +532,8 @@ int mhi_force_rddm_mode(struct mhi_controller *mhi_cntrl);
 #ifdef CONFIG_MHI_DEBUG
 
 #define MHI_VERB(fmt, ...) do { \
-		if (mhi_cntrl->klog_lvl <= MHI_MSG_VERBOSE) \
-			pr_dbg("[D][%s] " fmt, __func__, ##__VA_ARGS__);\
+		if (mhi_cntrl->klog_lvl <= MHI_MSG_LVL_VERBOSE) \
+			pr_debug("[D][%s] " fmt, __func__, ##__VA_ARGS__);\
 } while (0)
 
 #else
@@ -543,7 +543,7 @@ int mhi_force_rddm_mode(struct mhi_controller *mhi_cntrl);
 #endif
 
 #define MHI_LOG(fmt, ...) do {	\
-		if (mhi_cntrl->klog_lvl <= MHI_MSG_INFO) \
+		if (mhi_cntrl->klog_lvl <= MHI_MSG_LVL_INFO) \
 			pr_info("[I][%s] " fmt, __func__, ##__VA_ARGS__);\
 } while (0)
 
