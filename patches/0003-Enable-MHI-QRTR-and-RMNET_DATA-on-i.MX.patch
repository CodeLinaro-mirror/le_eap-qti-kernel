 drivers/qti/qrtr/Makefile            |  6 +++---
 drivers/qti/qrtr/qrtr.c              | 12 ++++++------
 drivers/qti/qrtr/qrtr.h              | 19 +++++++++++++++++++
 include/linux/mhi.h                  |  6 +++---
 9 files changed, 41 insertions(+), 67 deletions(-)

diff --git a/drivers/qti/mhi/controllers/Makefile b/drivers/qti/mhi/controllers/Makefile
